PORT=4000
NODE_ENV=development
DEV_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/stockly_db
JWT_SECRET=your_jwt_secret_here_change_in_production
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@stockly.church
UPLOADS_PATH=uploads

# ── Production (Render) ──────────────────────────────
# Neon connection string (used when NODE_ENV=production)
DATABASE_URL=postgres://USER:PASSWORD@HOST/neondb?sslmode=require
# Website origin(s) allowed to call the API, comma-separated
CORS_ORIGIN=https://your-site.vercel.app
# Used for links in emails
FRONTEND_URL=https://your-site.vercel.app
# Admin password used by `npm run run:seed` (required in production)
SEED_ADMIN_PASSWORD=
